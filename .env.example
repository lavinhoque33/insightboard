# ============================================
# InsightBoard Backend Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# Server Configuration
# ============================================
# Bind host for the backend. Loopback only; a non-loopback value is a deliberate,
# owner-approved change (project hard boundary), never a convenience.
APP_HOST=127.0.0.1
APP_PORT=8080

# Built frontend directory the backend serves beside the API (SPA fallback to index.html).
# Leave unset in development (Vite serves the frontend). When set, it must exist and contain
# index.html or startup fails. Relative paths start at the working directory (make backend-dev
# runs in backend/). The release image sets STATIC_DIR=/app/dist itself.
# STATIC_DIR=../frontend/dist

# Release app (make up): host port, published on 127.0.0.1 only. Read by docker compose,
# not by the backend; inside its container the app always binds 0.0.0.0:8080.
# APP_PUBLISH_PORT=8088

# ============================================
# Database Configuration
# ============================================
# For local development with Docker Compose. docker compose and the backend both read
# this root .env, so keep values plain: no quotes, no ${} references.
# Compose refuses to start while the three secrets below are empty. Generate URL-safe values:
#   openssl rand -hex 24
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# DATABASE_URL and REDIS_URL must carry the same values as the variables above.
DATABASE_URL=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/insightboard

# For production (Neon/Supabase):
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ============================================
# Redis Cache Configuration
# ============================================
# For local development with Docker Compose (same REDIS_PASSWORD as above):
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379

# For production (Upstash):
# REDIS_URL=rediss://default:password@host:port

# ============================================
# Authentication & Security
# ============================================
# Required. Leave empty here; `make setup` generates a value when it creates .env.
# Startup refuses a value shorter than 32 bytes. Manual generation: openssl rand -hex 32
JWT_SECRET=

# ============================================
# External API Keys (Optional for widgets)
# ============================================

# GitHub Widget - Personal Access Token
# Get one at: https://github.com/settings/tokens
# Required scopes: public_repo (for public repos)
GITHUB_API_TOKEN=

# OpenWeather API - Weather Widget
# Get a free key at: https://openweathermap.org/api
# Without it the weather endpoint answers 503. (OpenWeather only accepts the key in the
# query string; the backend never logs request URLs.)
OPENWEATHER_API_KEY=

# NewsAPI - News Widget (sent in the X-Api-Key header)
# Get a free key at: https://newsapi.org/
# Without it the news endpoint answers 503.
NEWSAPI_API_KEY=

# ============================================
# Outbound requests (Optional; defaults shown)
# ============================================
# Provider base URLs: the real APIs by default; tests and drills point them at local mocks.
# GITHUB_API_BASE_URL=https://api.github.com
# OPENWEATHER_API_BASE_URL=https://api.openweathermap.org
# NEWSAPI_API_BASE_URL=https://newsapi.org
# COINGECKO_API_BASE_URL=https://api.coingecko.com

# Shared provider client timeouts (milliseconds).
# PROVIDER_CONNECT_TIMEOUT_MS=3000
# PROVIDER_TIMEOUT_MS=8000

# Status widget: per-URL timeouts (milliseconds; at most 10 URLs, 5 at a time).
# STATUS_CONNECT_TIMEOUT_MS=2000
# STATUS_TIMEOUT_MS=4000

# Development-only status-widget fixture allowlist: comma-separated exact loopback ip:port
# entries (for example 127.0.0.1:18080) the status widget may reach despite the loopback
# block. Empty by default; never list anything but local fixtures.
STATUS_ALLOWED_FIXTURES=

# Server-side limit for handling one request (milliseconds); a slower request gets 504.
# REQUEST_TIMEOUT_MS=10000

# ============================================
# Rate limits (Optional; defaults shown)
# ============================================
# Register and login, per client IP.
# AUTH_RATE_LIMIT_PER_MINUTE=10
# AUTH_RATE_LIMIT_BURST=5
# /api/data/*, per signed-in user.
# DATA_RATE_LIMIT_PER_MINUTE=60
# DATA_RATE_LIMIT_BURST=30

# ============================================
# Logging & Observability (Optional)
# ============================================
# Read from this file at startup. Default: insightboard_backend=debug,tower_http=debug
RUST_LOG=info,insightboard_backend=debug

# ============================================
# CORS
# ============================================
# Comma-separated exact origins (scheme://host[:port], no path or wildcard) the browser
# may call the API from. Default (when unset): the Vite dev server,
# http://127.0.0.1:5173,http://localhost:5173
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
