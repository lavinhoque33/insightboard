# ============================================
# InsightBoard Backend Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# Server Configuration
# ============================================
# Bind host for the backend. Loopback only; a non-loopback value is a deliberate,
# owner-approved change (project hard boundary), never a convenience.
APP_HOST=127.0.0.1
APP_PORT=8080

# ============================================
# Database Configuration
# ============================================
# For local development with Docker Compose. docker compose and the backend both read
# this root .env, so keep values plain: no quotes, no ${} references.
# Compose refuses to start while the three secrets below are empty. Generate URL-safe values:
#   openssl rand -hex 24
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# DATABASE_URL and REDIS_URL must carry the same values as the variables above.
DATABASE_URL=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/insightboard

# For production (Neon/Supabase):
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ============================================
# Redis Cache Configuration
# ============================================
# For local development with Docker Compose (same REDIS_PASSWORD as above):
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379

# For production (Upstash):
# REDIS_URL=rediss://default:password@host:port

# ============================================
# Authentication & Security
# ============================================
# Required. Leave empty here; `make setup` generates a value when it creates .env.
# Manual generation (at least 32 bytes): openssl rand -hex 32
JWT_SECRET=

# ============================================
# External API Keys (Optional for widgets)
# ============================================

# GitHub Widget - Personal Access Token
# Get one at: https://github.com/settings/tokens
# Required scopes: public_repo (for public repos)
GITHUB_API_TOKEN=

# OpenWeather API - Weather Widget
# Get a free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# NewsAPI - News Widget
# Get a free key at: https://newsapi.org/
NEWSAPI_API_KEY=

# ============================================
# Logging & Observability (Optional)
# ============================================
# Read from this file at startup. Default: insightboard_backend=debug,tower_http=debug
RUST_LOG=info,insightboard_backend=debug

# ============================================
# CORS
# ============================================
# Comma-separated exact origins (scheme://host[:port], no path or wildcard) the browser
# may call the API from. Default (when unset): the Vite dev server,
# http://127.0.0.1:5173,http://localhost:5173
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
