{
	"name": "insightboard-infra",
	"version": "0.0.0",
	"private": true,
	"description": "Synth-only CDK definition of the InsightBoard M7 experiment (M6; no deploy).",
	"license": "MIT",
	"type": "commonjs",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "npm run build && node --test dist/test/*.test.js",
		"synth": "npm run build && node dist/src/synth.js",
		"check": "npm run build && node --test dist/test/*.test.js && node dist/src/synth.js",
		"cfn-lint": "sh scripts/cfn-lint.sh"
	},
	"dependencies": {
		"aws-cdk-lib": "2.273.0",
		"cdk-nag": "3.0.2",
		"constructs": "10.8.1"
	},
	"devDependencies": {
		"@types/node": "20.19.43",
		"typescript": "~5.9.3"
	}
}
