{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insightboard.local/contracts/api-contract.v1.json",
  "title": "InsightBoard API Contract v1",
  "description": "Contract-first schema for backend/frontend integration. Both layers must conform to these request/response shapes. Every error response is ErrorResponse, or ValidationErrorResponse for 422; status codes per endpoint are listed in docs/architecture/system-overview.md.",
  "type": "object",
  "required": [
    "auth",
    "dashboards",
    "widgets",
    "errors",
    "health"
  ],
  "properties": {
    "auth": {
      "type": "object",
      "required": [
        "register_request",
        "login_request",
        "auth_response",
        "current_user_response"
      ],
      "properties": {
        "register_request": {
          "$ref": "#/$defs/RegisterRequest"
        },
        "login_request": {
          "$ref": "#/$defs/LoginRequest"
        },
        "auth_response": {
          "$ref": "#/$defs/AuthResponse"
        },
        "current_user_response": {
          "$ref": "#/$defs/User"
        }
      }
    },
    "dashboards": {
      "type": "object",
      "required": [
        "dashboard",
        "list_response",
        "create_request",
        "update_request"
      ],
      "properties": {
        "dashboard": {
          "$ref": "#/$defs/Dashboard"
        },
        "list_response": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dashboard"
          }
        },
        "create_request": {
          "$ref": "#/$defs/CreateDashboardRequest"
        },
        "update_request": {
          "$ref": "#/$defs/UpdateDashboardRequest"
        }
      }
    },
    "widgets": {
      "type": "object",
      "required": [
        "github",
        "weather",
        "news",
        "crypto",
        "status"
      ],
      "properties": {
        "github": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GitHubEvent"
          }
        },
        "weather": {
          "$ref": "#/$defs/WeatherData"
        },
        "news": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NewsArticle"
          }
        },
        "crypto": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CryptoPrice"
          }
        },
        "status": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StatusCheck"
          }
        }
      }
    },
    "errors": {
      "type": "object",
      "required": [
        "error_response",
        "validation_error_response"
      ],
      "properties": {
        "error_response": {
          "$ref": "#/$defs/ErrorResponse"
        },
        "validation_error_response": {
          "$ref": "#/$defs/ValidationErrorResponse"
        }
      }
    },
    "health": {
      "type": "object",
      "required": [
        "healthz_response",
        "readyz_response"
      ],
      "properties": {
        "healthz_response": {
          "$ref": "#/$defs/HealthResponse"
        },
        "readyz_response": {
          "$ref": "#/$defs/ReadyResponse"
        }
      }
    }
  },
  "$defs": {
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "description": "Body of every non-2xx response except 422: 400 malformed JSON, 401 (always \"Unauthorized\"), 404, 405 (method not allowed), 409, 413 (payload too large), 415, 429, 500, 502 (generic upstream failure), 503 (missing provider key or /readyz dependency down), 504 (server request timeout)."
    },
    "ValidationDetail": {
      "type": "object",
      "required": [
        "field",
        "message"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "description": "Request field name, dotted for nested JSON (layout_json.widgets.0.w); the parameter name for query parameters."
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ValidationErrorResponse": {
      "description": "422 body: well-formed input that is missing, mistyped, or invalid.",
      "type": "object",
      "required": [
        "error",
        "details"
      ],
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ValidationDetail"
          }
        }
      },
      "additionalProperties": false
    },
    "HealthResponse": {
      "description": "GET /healthz: dependency-free liveness.",
      "type": "object",
      "required": [
        "status",
        "service",
        "version"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "ok"
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ReadyResponse": {
      "description": "GET /readyz 200 body when Postgres and Redis answer; otherwise 503 ErrorResponse.",
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "ready"
        }
      },
      "additionalProperties": false
    },
    "RegisterRequest": {
      "type": "object",
      "required": [
        "email",
        "password"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "password": {
          "type": "string",
          "minLength": 8
        }
      },
      "additionalProperties": false
    },
    "LoginRequest": {
      "type": "object",
      "required": [
        "email",
        "password"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "password": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "User": {
      "type": "object",
      "required": [
        "id",
        "email",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "AuthResponse": {
      "type": "object",
      "required": [
        "token",
        "user"
      ],
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "$ref": "#/$defs/User"
        }
      },
      "additionalProperties": false
    },
    "WidgetLayout": {
      "type": "object",
      "required": [
        "id",
        "type",
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "weather",
            "crypto",
            "github",
            "news",
            "status"
          ]
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        },
        "config": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "LayoutConfig": {
      "type": "object",
      "required": [
        "widgets"
      ],
      "properties": {
        "widgets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WidgetLayout"
          }
        }
      },
      "additionalProperties": false
    },
    "DashboardSettings": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "title": {
          "type": "string"
        },
        "refresh_interval": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "Dashboard": {
      "type": "object",
      "required": [
        "id",
        "user_id",
        "name",
        "layout_json",
        "settings_json",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "layout_json": {
          "$ref": "#/$defs/LayoutConfig"
        },
        "settings_json": {
          "$ref": "#/$defs/DashboardSettings"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "CreateDashboardRequest": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "layout_json": {
          "$ref": "#/$defs/LayoutConfig"
        },
        "settings_json": {
          "$ref": "#/$defs/DashboardSettings"
        }
      },
      "additionalProperties": false,
      "description": "Omitted layout_json/settings_json are stored as {\"widgets\":[]} and {}."
    },
    "UpdateDashboardRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "layout_json": {
          "$ref": "#/$defs/LayoutConfig"
        },
        "settings_json": {
          "$ref": "#/$defs/DashboardSettings"
        }
      },
      "additionalProperties": false
    },
    "GitHubEvent": {
      "type": "object",
      "required": [
        "id",
        "type",
        "repo",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "WeatherData": {
      "type": "object",
      "required": [
        "city",
        "country",
        "temperature",
        "feels_like",
        "humidity",
        "description",
        "wind_speed",
        "icon"
      ],
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": "number"
        },
        "feels_like": {
          "type": "number"
        },
        "humidity": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "wind_speed": {
          "type": "number"
        },
        "icon": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "NewsArticle": {
      "type": "object",
      "required": [
        "title",
        "description",
        "url",
        "source",
        "publishedAt"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "urlToImage": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "CryptoPrice": {
      "type": "object",
      "required": [
        "id",
        "symbol",
        "name",
        "current_price",
        "price_change_percentage_24h",
        "market_cap",
        "total_volume"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "current_price": {
          "type": [
            "number",
            "null"
          ]
        },
        "price_change_percentage_24h": {
          "type": [
            "number",
            "null"
          ]
        },
        "market_cap": {
          "type": [
            "number",
            "null"
          ]
        },
        "total_volume": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "description": "A numeric field that is null upstream stays null."
    },
    "StatusCheck": {
      "type": "object",
      "required": [
        "url",
        "status",
        "response_time_ms"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "The URL as requested (trimmed)."
        },
        "status": {
          "type": "integer",
          "minimum": 0
        },
        "response_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatusErrorClass"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "One result per requested URL, in request order. A 3xx is reported as that status (redirects are not followed). On failure status and response_time_ms are 0 and error is a StatusErrorClass."
    },
    "StatusErrorClass": {
      "description": "invalid_url: unparsable, not http/https, credentials in the URL, or too long. blocked_address: the host is or resolves to a loopback, private, link-local, CGNAT, unspecified, multicast, broadcast, documentation, benchmarking, reserved, or metadata address (outside the dev fixture allowlist). dns_error: the host did not resolve. timeout: no response within the per-URL timeout. connect_error: the connection failed. request_error: any other failure.",
      "type": "string",
      "enum": [
        "invalid_url",
        "blocked_address",
        "dns_error",
        "timeout",
        "connect_error",
        "request_error"
      ]
    }
  }
}
